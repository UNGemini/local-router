{
  "openapi": "3.0.3",
  "info": {
    "title": "Wheels Router API",
    "description": "Wheels Router is a free, unlimited, provider-neutral public API service for multi-modal trip planning in Hong Kong.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://engine.justusewheels.com",
      "description": "Wheels Router endpoint"
    }
  ],
  "paths": {
    "/v1/plan": {
      "get": {
        "summary": "Plan a trip",
        "description": "Calculate trip plans between an origin and a destination using various transit modes.",
        "operationId": "planTrip",
        "parameters": [
          {
            "name": "origin",
            "in": "query",
            "description": "Starting point of the trip. Can be \"lat,lon\" coordinates or a \"stop:ID\".",
            "required": true,
            "schema": {
              "type": "string",
              "example": "22.297432,114.237296"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "description": "Destination of the trip. Can be \"lat,lon\" coordinates or a \"stop:ID\".",
            "required": true,
            "schema": {
              "type": "string",
              "example": "22.280843,114.180558"
            }
          },
          {
            "name": "depart_at",
            "in": "query",
            "description": "Desired departure time in ISO 8601 format. Cannot be used with `arrive_by`.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "arrive_by",
            "in": "query",
            "description": "Desired arrival time in ISO 8601 format. Cannot be used with `depart_at`.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "modes",
            "in": "query",
            "description": "Comma-separated list of allowed transit modes (e.g., \"mtr,bus,ferry\").",
            "schema": {
              "type": "string",
              "example": "mtr,bus"
            }
          },
          {
            "name": "exclude_modes",
            "in": "query",
            "description": "Comma-separated list of excluded transit modes.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exclude_routes",
            "in": "query",
            "description": "Comma-separated list of route IDs to exclude.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exclude_stops",
            "in": "query",
            "description": "Comma-separated list of stop IDs to exclude.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_transfers",
            "in": "query",
            "description": "Maximum number of transfers allowed.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "default": 3
            }
          },
          {
            "name": "max_results",
            "in": "query",
            "description": "Maximum number of trip plans to return.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15
            }
          },
          {
            "name": "walking_speed",
            "in": "query",
            "description": "Walking speed preference.",
            "schema": {
              "type": "string",
              "enum": [
                "slow",
                "normal",
                "fast"
              ],
              "default": "normal"
            }
          },
          {
            "name": "max_walk_distance",
            "in": "query",
            "description": "Maximum walking distance in meters.",
            "schema": {
              "type": "integer",
              "maximum": 5000
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Language code for response text (e.g., \"en\", \"zh\", \"zh-Hant\").",
            "schema": {
              "type": "string",
              "default": "en"
            }
          },
          {
            "name": "modifier",
            "in": "query",
            "description": "Optimization modifier for the trip plan.",
            "schema": {
              "type": "string",
              "enum": [
                "less-walking",
                "less-transfer"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful trip plan response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                },
                "example": {
