  "components": {
    "schemas": {
      "PlanResponse": {
        "type": "object",
        "properties": {
          "plans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Plan"
            }
          },
          "debug": {
            "type": "object",
            "description": "Debug information (if enabled)"
          }
        },
        "required": [
          "plans"
        ]
      },
      "Plan": {
        "type": "object",
        "properties": {
          "duration_seconds": {
            "type": "integer",
            "description": "Total duration of the trip in seconds."
          },
          "duration_seconds_min": {
            "type": "integer",
            "description": "Minimum duration considering fastest route options."
          },
          "duration_seconds_max": {
            "type": "integer",
            "description": "Maximum duration considering slowest route options."
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "description": "Departure time of the trip."
          },
          "legs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Leg"
            }
          },
          "fares_min": {
            "type": "integer",
            "description": "Minimum total fare in smallest currency unit (e.g., cents)."
          },
          "fares_max": {
            "type": "integer",
            "description": "Maximum total fare in smallest currency unit."
          },
          "currency": {
            "type": "string",
            "description": "Currency code (e.g., HKD)."
          }
        },
        "required": [
          "duration_seconds",
          "start_time",
          "legs"
        ]
      },
      "Leg": {
        "type": "object",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "walk": "#/components/schemas/WalkLeg",
            "transit": "#/components/schemas/TransitLeg",
            "wait": "#/components/schemas/WaitLeg",
            "station_transfer": "#/components/schemas/StationTransferLeg"
          }
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/WalkLeg"
          },
          {
            "$ref": "#/components/schemas/TransitLeg"
          },
          {
            "$ref": "#/components/schemas/WaitLeg"
          },
          {
            "$ref": "#/components/schemas/StationTransferLeg"
          }
        ]
      },
      "WalkLeg": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "walk"
            ]
          },
          "walk_type": {
            "type": "string",
            "enum": [
              "station_access",
              "station_transfer"
            ],
            "nullable": true
          },
          "from": {
            "$ref": "#/components/schemas/Location"
          },
          "to": {
            "$ref": "#/components/schemas/Location"
          },
          "duration_seconds": {
            "type": "integer"
          },
          "distance_meters": {
            "type": "integer"
          },
          "polyline": {
            "type": "string",
            "description": "Encoded polyline string."
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "type",
          "duration_seconds"
        ]
      },
      "TransitLeg": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "transit"
            ]
          },
          "route_options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteOption"
            }
          }
        },
        "required": [
          "type",
          "route_options"
        ]
      },
      "WaitLeg": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "wait"
            ]
          },
          "duration_seconds": {
            "type": "integer"
          }
        },
        "required": [
          "type",
          "duration_seconds"
        ]
      },
      "StationTransferLeg": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "station_transfer"
            ]
          },
          "from_platform": {
            "type": "string"
          },
          "to_platform": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "integer"
          },
          "distance_meters": {
            "type": "integer"
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "type",
          "duration_seconds",
          "distance_meters"
        ]
      },
      "RouteOption": {
        "type": "object",
        "properties": {
          "route_id": {
            "type": "string"
          },
          "trip_id": {
            "type": "string"
          },
          "route_name": {
            "type": "string"
          },
          "route_long_name": {
            "type": "string"
          },
          "route_short_name": {
            "type": "string"
          },
          "headsign": {
            "type": "string"
          },
          "agency": {
            "$ref": "#/components/schemas/Agency"
          },
          "mode": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "integer"
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          },
          "color": {
            "type": "string"
          },
          "text_color": {
            "type": "string"
          },
          "fare": {
            "$ref": "#/components/schemas/Fare"
          },
          "stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Stop"
            }
          },
          "from": {
            "$ref": "#/components/schemas/Stop"
          },
          "to": {
            "$ref": "#/components/schemas/Stop"
          }
        },
        "required": [
          "route_id",
          "route_name",
          "agency",
          "mode",
          "duration_seconds",
          "stops",
          "from",
          "to"
        ]
      },
      "Location": {
        "type": "object",
        "properties": {
          "location": {
            "$ref": "#/components/schemas/LocationPoint"
          },
          "address": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "stop_id": {
            "type": "string"
          },
          "entrance": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          }
        },
        "required": [
          "location"
        ]
      },
      "Stop": {
        "type": "object",
        "properties": {
          "location": {
            "$ref": "#/components/schemas/LocationPoint"
          },
          "id": {
            "type": "string"
          },
          "stop_id": {
            "type": "string"
          },
          "stop_name": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "exit": {
            "type": "string"
          },
          "access_via": {
            "type": "string"
          },
          "arrival_offset_minutes": {
            "type": "integer"
          },
          "departure_offset_minutes": {
            "type": "integer"
          }
        },
        "required": [
          "location"
        ]
      },
      "LocationPoint": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lon": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "lat",
          "lon"
        ]
      },
      "Agency": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Fare": {
        "type": "object",
        "properties": {
          "base_fare": {
            "type": "integer"
          },
          "discount": {
            "$ref": "#/components/schemas/FareDiscount"
          },
          "final_fare": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "base_fare",
          "currency"
        ]
      },
      "FareDiscount": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "rules": {
            "$ref": "#/components/schemas/FareDiscountRules"
          }
        },
        "required": [
          "amount",
          "type"
